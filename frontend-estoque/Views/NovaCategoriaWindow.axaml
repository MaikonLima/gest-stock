<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GerenciamentoEstoque.ViewModels"
        x:Class="GerenciamentoEstoque.Views.NovaCategoriaWindow"
        x:DataType="vm:CategoriasViewModel"
        Width="380" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Nova categoria">
    <StackPanel Margin="20" Spacing="6">
        <TextBlock Text="Nome" />
        <TextBox Text="{Binding NovoNome}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button Content="Cancelar" Click="OnCancelClick" />
            <Button Content="Salvar" Click="OnSalvarClick" />
        </StackPanel>
    </StackPanel>
</Window>
